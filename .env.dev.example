# Local dev override for running `main.py serve` (or any script) against
# the local Docker Postgres instead of SQLite -- see docker-compose.test.yml
# for how to start that container, and scripts/seed_local_dev_db.py for how
# "signals_dev" gets its schema + demo companies + admin login.
#
# Deliberately a SEPARATE file from .env, not merged into it: .env holds
# real production Neon credentials (NEON=...) used for the deploy/smoke-test
# workflow, which must keep defaulting to SQLite unless a run explicitly
# opts into Postgres -- putting DATABASE_BACKEND=postgres in .env itself
# would silently redirect every `--env-file .env` run (deploy smoke tests
# included) at whichever of these two vars wins, easy to get backwards.
#
# Usage: copy this to .env.dev, then either `source .env.dev` before running
# `python main.py serve` / pytest, or merge its two lines into your own
# shell profile / direnv config. Never commit .env.dev itself (gitignored,
# same as .env) -- this .example file is the only one checked in.

export DATABASE_BACKEND=postgres
export LOCAL_DEV_DATABASE_URL=postgresql://signals_test:signals_test@localhost:5433/signals_dev
